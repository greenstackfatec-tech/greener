# Portas publicadas na máquina host
FRONTEND_PORT=8080
BACKEND_PORT=3000
POSTGRES_PORT=5432

# Banco PostgreSQL (use credenciais próprias fora do ambiente local)
POSTGRES_DB=greener
POSTGRES_USER=greener
POSTGRES_PASSWORD=greener_dev_only

# APIs externas usadas pelas integrações do backend
METRICS_API_URL=https://metrics.unilaunch.org
CARBON_API_URL=https://carbon.unilaunch.org
API_TIMEOUT_MS=10000