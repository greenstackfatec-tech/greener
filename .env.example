# Portas publicadas na máquina host
FRONTEND_PORT=8080
BACKEND_PORT=3000
POSTGRES_PORT=5432

# Atualização automática do dashboard, em segundos (mínimo 5; padrão 30).
# A coleta do backend usa 'intervalo_coleta_segundos' na tabela configuracoes (padrão 60).
INTERVALO_ATUALIZACAO_SEGUNDOS=30
COLLECTIONS_AUTO_START=true

# Banco PostgreSQL (use credenciais próprias fora do ambiente local)
POSTGRES_DB=greener
POSTGRES_USER=greener
POSTGRES_PASSWORD=greener_dev_only

# Apenas desenvolvimento local; fora dele, gere uma chave própria com o comando abaixo.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=greener-local-development-only-change-before-deploy

# APIs externas usadas pelas integrações do backend
METRICS_API_URL=https://metrics.unilaunch.org
CARBON_API_URL=https://carbon.unilaunch.org
API_TIMEOUT_MS=10000
